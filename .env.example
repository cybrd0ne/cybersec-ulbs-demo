# Copy to .env and adjust ports if they clash locally. Non-secret values only.
# The admin password is NOT here; it lives SOPS-encrypted in secrets/opensearch.enc.yaml
# and is decrypted into .env.secrets by `make secrets`.

# Host ports (container ports are fixed inside compose.yaml)
OS_HTTP_PORT=9200
OSD_PORT=5601
FRONTDOOR_HTTPS_PORT=8443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

# Non-secret Grafana admin password for the local demo only. Override in .env.
GRAFANA_ADMIN_PASSWORD=demo-grafana
